{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ZentinelaConnection": "Server=__DB_SERVER__;Database=DBZentinela;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=True;",
    "CallCenterConnection": "Server=__DB_SERVER__;Database=DBCallCenter;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=True;",
    "RecursosHumanosConnection": "Server=__DB_SERVER__;Database=DBRecursosHumanos;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "__JWT_SECRET__",
    "Issuer": "Zentinela",
    "Audience": "ZentinelaUsers",
    "ExpirationHours": 8
  }
}
