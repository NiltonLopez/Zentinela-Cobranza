<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <clear />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <security>
        <requestFiltering>
          <!-- 120 MB. IIS filtra ANTES del pipeline de ASP.NET Core: sin esto rige el
               default de 30.000.000 bytes (~28,6 MB) y el upload muere con un 404.13
               que el [RequestSizeLimit] del controller nunca llega a ver.
               Se deja en el techo del endpoint mas permisivo (Uso de Base de Datos, 120 MB);
               cada endpoint impone su limite exacto con su propio [RequestSizeLimit]. -->
          <requestLimits maxAllowedContentLength="125829120" />
        </requestFiltering>
      </security>
      <!-- requestTimeout: el cruce de "Uso de Base de Datos" puede tardar ~2 min con
           1.000.000 de numeros. El default de ANCM es 00:02:00, peligrosamente justo.
           Se sube a 20 min para que IIS no corte una consulta legitima en curso. -->
      <aspNetCore processPath="dotnet" arguments=".\Zentinela.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" requestTimeout="00:20:00">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
